<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- SERVER GC (measured 2026-10-04: the suite 8:16 → 2:11 wall). The tests run twelve allocation-heavy fights and
         map generations side by side, and the workstation collector stops every thread for each collection —
         the tests spent most of their time waiting on each other's garbage. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Converter\BnbContent.Converter.csproj" />
    <ProjectReference Include="..\..\RogueDeck-Core\src\RogueDeck.Sandbox.Run\RogueDeck.Sandbox.Run.csproj" />
  </ItemGroup>

</Project>