{
  // A worked example, and the shape every snapshot has. Everything below has a default; the smallest
  // useful file is {"enemy": "…"} or {"encounter": "…"}.
  //
  // This one asks a real question: what does the Act-IV Tombbreakers elite cost a PAPERWORK deck of about
  // the size a run carries by then, holding the four relics such a deck would want?
  "name": "Tombbreakers · a paperwork deck, mid Act IV",
  "encounter": "labyrinth_elite_the_tombbreakers_three",

  "maxHealth": 80,
  "health": 62,
  "energy": 3,

  // Nineteen CANONICAL cards: file the paperwork, then cash it. They were ported v2 cards until 2026-09-10,
  // when the 25 demo leftovers left the game — the same regression this file caught for the relics below,
  // one arc later and one entity kind over.
  "deck": [
    "form_of_ill_intent", "form_of_ill_intent", "form_of_ill_intent",
    "cross_filing", "cross_filing",
    "broom_dispatch", "broom_dispatch",
    "permit_a38",
    "errata_furnace", "dead_letter_office",
    "summary_judgment", "summary_judgment",
    "inkblot_verdict", "inkblot_verdict",
    "paper_cut", "paper_cut", "paper_cut",
    "strong_binder", "strong_binder"
  ],

  // Four CANONICAL relics such a deck would want. They were four ported v2 relics until 2026-09-10, when
  // the 47 demo relics left the game — a snapshot next to the content is a regression test, and this is the
  // regression it caught.
  "relics": [
    "formkeepers_signet",
    "black_salt_charm",
    "concordance_medallion",
    "chancery_ribbon"
  ],

  "fights": 20,
  "seed": 1,
